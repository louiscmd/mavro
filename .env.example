# Stripe secret key — use a TEST-mode key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Public URL of the site (Stripe redirects, canonical URLs, Open Graph).
# Locally: http://localhost:3000 — on Vercel: https://your-domain.com
# (On Vercel, if unset, the deployment URL is used automatically.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
